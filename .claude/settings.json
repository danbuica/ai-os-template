{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-start=!sh .os/session-start.sh claude\" aios-start",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-live=!sh .os/live.sh claude start\" aios-live",
            "async": true,
            "timeout": 15
          },
          {
            "type": "command",
            "command": "git -c \"alias.aios-apps=!sh .os/apps.sh refresh claude\" aios-apps",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-live=!sh .os/live.sh claude prompt\" aios-live",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-live=!sh .os/live.sh claude expand\" aios-live",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-live=!sh .os/live.sh claude tool\" aios-live",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-live=!sh .os/live.sh claude stop\" aios-live",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.aios-live=!sh .os/live.sh claude end\" aios-live",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
